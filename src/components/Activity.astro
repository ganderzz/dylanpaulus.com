---
import type { ActivityData } from "@utils/activity";
import { formatMovingTime } from "@utils/activity";

type Props = {
  data: ActivityData;
  type?: string;
  distanceMi?: number;
  elevationFt?: number;
  movingTimeSec?: number;
  caption?: string;
};

const props = Astro.props as Props;
const { data } = props;

const type = props.type ?? data.type;
const distanceMi = props.distanceMi ?? data.distanceMi;
const elevationFt = props.elevationFt ?? data.elevationFt;
const movingTimeSec = props.movingTimeSec ?? data.movingTimeSec;
const caption = props.caption ?? data.caption;

const pts = data.trace.points;
const xs = pts.map((p) => p[0]);
const ys = pts.map((p) => p[1]);
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
const minY = Math.min(...ys);
const maxY = Math.max(...ys);
const traceW = maxX - minX || 1;
const traceH = maxY - minY || 1;
const span = Math.max(traceW, traceH);
const pad = span * 0.07;
const viewBox = `${minX - pad} ${minY - pad} ${traceW + pad * 2} ${traceH + pad * 2}`;
const strokeW = span * 0.022;
const dotR = span * 0.034;
const tracePoints = pts.map((p) => `${p[0]},${p[1]}`).join(" ");
const start = pts[0];
const end = pts[pts.length - 1];

const EV_W = 100;
const EV_H = 56;
const EV_PAD = 3;
const elePoints = (data.elevation?.points ?? []).map(
  ([d, e]) => [d * EV_W, EV_PAD + (1 - e) * (EV_H - EV_PAD * 2)] as const
);
const eleLine = elePoints
  .map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(2)},${p[1].toFixed(2)}`)
  .join(" ");
const eleArea =
  elePoints.length > 1
    ? `${eleLine} L${elePoints[elePoints.length - 1][0].toFixed(2)},${EV_H} L${elePoints[0][0].toFixed(2)},${EV_H} Z`
    : "";

const stats = [
  { label: "Distance", value: `${distanceMi} mi` },
  { label: "Elevation", value: `${elevationFt.toLocaleString("en-US")} ft` },
  { label: "Moving time", value: formatMovingTime(movingTimeSec) },
];
---

<figure class="kb-activity">
  <div class="kb-activity-card">
    <div class="kb-activity-head">
      <span class="kb-activity-type">
        <span class="kb-activity-dot"></span>
        {type}
      </span>
    </div>

    <svg
      class="kb-activity-trace"
      viewBox={viewBox}
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label={`Route trace for a ${distanceMi} mile ${type.toLowerCase()}`}>
      <polyline
        points={tracePoints}
        fill="none"
        stroke="var(--brand-indigo)"
        stroke-width={strokeW}
        stroke-linejoin="round"
        stroke-linecap="round"
      />
      <circle
        cx={start[0]}
        cy={start[1]}
        r={dotR}
        fill="var(--brand-yellow)"
        stroke="var(--brand-card)"
        stroke-width={strokeW * 0.5}
      />
      <circle
        cx={end[0]}
        cy={end[1]}
        r={dotR}
        fill="var(--brand-card)"
        stroke="var(--brand-indigo)"
        stroke-width={strokeW}
      />
    </svg>

    {
      eleArea && (
        <div class="kb-activity-elev">
          <span class="kb-activity-eyebrow">Elevation profile</span>
          <svg
            class="kb-activity-elev-svg"
            viewBox={`0 0 ${EV_W} ${EV_H}`}
            preserveAspectRatio="none"
            role="img"
            aria-label="Elevation profile over the route">
            <path d={eleArea} fill="var(--brand-indigo)" opacity="0.14" />
            <path
              d={eleLine}
              fill="none"
              stroke="var(--brand-indigo)"
              stroke-width="1.5"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
      )
    }

    <div class="kb-activity-stats">
      {
        stats.map((stat, i) => (
          <>
            {i > 0 && <span class="kb-activity-rule" />}
            <div class="kb-activity-stat">
              <span class="kb-activity-eyebrow">{stat.label}</span>
              <span class="kb-activity-value">{stat.value}</span>
            </div>
          </>
        ))
      }
    </div>
  </div>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .kb-activity {
    margin: 28px 0;
  }
  .kb-activity-card {
    background: var(--brand-card);
    border: 1px solid var(--brand-rule);
    border-radius: 16px;
    padding: 22px;
  }
  .kb-activity-head {
    margin-bottom: 14px;
  }
  .kb-activity-type {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border: 1px solid var(--brand-rule);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--brand-fg2);
  }
  .kb-activity-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--brand-yellow);
  }
  .kb-activity-trace {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
  }
  .kb-activity-elev {
    margin-top: 14px;
  }
  .kb-activity-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--brand-fg2);
  }
  .kb-activity-elev-svg {
    display: block;
    width: 100%;
    height: 72px;
    margin-top: 6px;
  }
  .kb-activity-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--brand-rule);
  }
  .kb-activity-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .kb-activity-value {
    font-size: 16px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--brand-ink);
  }
  .kb-activity-rule {
    width: 1px;
    height: 30px;
    background: var(--brand-rule);
  }
</style>
